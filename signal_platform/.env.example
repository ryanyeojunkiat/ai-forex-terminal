# AlphaEdge Gold Signals — Environment Variables
# Copy this to .env and fill in your actual values

# Telegram Bot (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@alphaedge_gold

# MetaAPI (https://metaapi.cloud — connects to your MT5)
METAAPI_TOKEN=your_metaapi_token
METAAPI_ACCOUNT=your_account_id

# Twelve Data (https://twelvedata.com — free tier: 8 req/min)
TWELVE_DATA_API_KEY=your_twelve_data_key

# Supabase (for trade history persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
